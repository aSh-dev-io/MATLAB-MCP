  "analysis_conventions": {
    "conduction_leakage_multiple": {
      "value": 100.0,
      "justification": "A sample counts as conducting when |ID| >= 100 x I_leak. 100x is an analysis convention, chosen so channel current dominates the dataset-anchored leakage model (IDSS = 4 uA at 25 degC) by two decades. It is a classification choice, not a physical constant."
    },
    "vds_positive_floor_V": {
      "value": 1e-06,
      "justification": "Numerical floor only. At Vds = 0 the ratio Vds/ID is identically zero regardless of the device's true resistance."
    },
    "operating_point_decimals": {
      "value": 3,
      "justification": "Biases are snapped to 1e-3 V / 1e-3 degC so that repeated samples at nominally identical conditions group into one comparison bucket. Sampling noise is far below this."
    }
  },
  "tolerances": {
    "kcl_atol": {
      "value": 1e-09,
      "justification": "Node current balance ID+IG+IS=0 is an algebraic identity in the Stage 1 model; the tolerance covers float64 round-off over Vgs/ID magnitudes up to ~2e3 A, not model error."
    },
    "power_balance_atol": {
      "value": 1e-09,
      "justification": "Ploss is defined as Pcond+Psw in the Stage 1 terminal script, so any residual is float64 round-off only."
    },
    "csv_mat_rtol": {
      "value": 1e-09,
      "justification": "The CSV and MAT hold the same arrays, but MATLAB writes CSV as text with roughly 10 significant digits, so agreement is bounded by that formatting rather than being exact. Observed worst case is ~2.7e-10 relative, on gate-ramp voltages such as 1.0526315789473684 written as 1.052631579. Anything larger would indicate a real misalignment."
    },
    "ron_positive_floor_ohm": {
      "value": 1e-09,
      "justification": "A conduction resistance is strictly positive. A non-positive value is an artefact of Vds/ID with Vds=0, not a measurement of zero ohms."
    }
  },
